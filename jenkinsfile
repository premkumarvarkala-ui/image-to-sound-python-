
pipeline {
    agent any

    stages {

        stage("Clean Workspace") {
            steps {
                cleanWs()
            }
        }

        stage("Git Checkout") {
            steps {
                git branch: 'master',
                    url: 'https://github.com/premkumarvarkala-ui/image-to-sound-python-.git'
            }
        }

        stage("Python Version") {
            steps {
                sh '''
                    python3 --version
                    python3 -m pip --version
                '''
            }
        }

        stage("Install Dependencies") {
            steps {
                sh '''
                    python3 -m pip install -r requirements.txt
                '''
            }
        }

        stage("Run Unit Tests") {
            steps {
                sh '''
                    mkdir -p reports
                    python3 -m pytest -v \
                    --junitxml=reports/pytest-results.xml
                '''
            }
        }

        stage("Run Python Application") {
            steps {
                sh 'python3 main.py'
            }
        }

        stage("Create Build Artifact") {
            steps {
                sh '''
                    mkdir -p dist

                    zip -r dist/python-calculator.zip \
                        calculator.py \
                        main.py \
                        requirements.txt
                '''
            }
        }

        stage("Verify Artifact") {
            steps {
                sh '''
                    ls -lh dist/
                    unzip -l dist/python-calculator.zip
                '''
            }
        }
    }

    post {

        always {
            junit allowEmptyResults: true,
                  testResults: 'reports/pytest-results.xml'
        }

        success {
            archiveArtifacts artifacts: 'dist/*.zip',
                             fingerprint: true

            echo 'Python CI pipeline completed successfully!'
            echo 'Artifact generated and archived!'
        }

        failure {
            echo 'Python CI pipeline failed!'
        }
    }
}
